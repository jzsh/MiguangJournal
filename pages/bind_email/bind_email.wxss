.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}
.desc {
  background: #e8f8f0;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 24rpx;
}
.input-group {
  margin-bottom: 30rpx;
}
.label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.input {
  display: block;
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.btn {
  width: 100%;
  background: #00b26a;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  text-align: center;
}
.btn-unbind {
  width: 100%;
  background: #fff;
  color: #ff4757;
  border: 2rpx solid #ff4757;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 20rpx;
}
.status {
  text-align: center;
  margin-top: 24rpx;
  padding: 16rpx;
}
.success { color: #00b26a; font-size: 28rpx; }
.error { color: #ff4757; font-size: 28rpx; }
