.tab-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 4rpx 0 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  position: relative;
}

.tab-indicator {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  margin-bottom: 6rpx;
}

.tab-item.selected .tab-indicator {
  background: #00b26a;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.tab-item.selected .tab-text {
  color: #00b26a;
  font-weight: 600;
}
